# Copy to .env and fill in real values. Never commit .env (see docs/constitution.md SEC-001).

# Supabase Postgres — pooled connection (pgbouncer, port 6543), used by the app at runtime.
DATABASE_URL=

# Supabase Postgres — direct connection (port 5432), used by Prisma Migrate/CLI only.
DIRECT_URL=

# Supabase Auth (docs/decisions/0005-multi-user-supabase-auth.md). Publishable
# by design (not a secret, unlike DATABASE_URL/DIRECT_URL above) — safe in the
# client bundle, but still not hardcoded here; fill in the real project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Strava OAuth app credentials (docs/specs/01-strava-sync/spec.md).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Vercel AI Gateway API key for the chat layer (Claude models, routed via
# Gateway instead of a direct Anthropic provider — see
# docs/decisions/0006-vercel-ai-gateway.md) and for onboarding voice-memo
# transcription (google/gemini-3.5-transcribe-live, see
# docs/decisions/0007-vercel-ai-gateway-transcription.md). Not needed on
# Vercel deployments themselves (OIDC is used there automatically), but
# required for local dev/CI.
AI_GATEWAY_API_KEY=
