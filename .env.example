# Copy to .env and fill in real values. Never commit .env (see docs/constitution.md SEC-001).

# Supabase Postgres — pooled connection (pgbouncer, port 6543), used by the app at runtime.
DATABASE_URL=

# Supabase Postgres — direct connection (port 5432), used by Prisma Migrate/CLI only.
DIRECT_URL=

# Strava OAuth app credentials (docs/specs/01-strava-sync/spec.md).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Anthropic API key for the chat layer (docs/decisions/0003-chat-layer-vercel-ai-sdk.md).
ANTHROPIC_API_KEY=
